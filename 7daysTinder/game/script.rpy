# FUNCTIONS:
transform righter:
    xalign 1.00
    yalign 1.00

transform old_tv:
    function dynamic_tv_shake

init python:
    import random
    def dynamic_tv_shake(trans, st, at):
        trans.alpha = 0.15 + 0.1 * random.random()
        trans.xoffset = random.choice([-1, 0, 1])
        trans.yoffset = random.choice([-1, 0, 1])
        return 0.1


